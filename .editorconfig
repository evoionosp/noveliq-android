# Formatting rules for Noveliq. ktlint reads this file directly, and so does
# IntelliJ / Android Studio — one source of truth for the IDE and the build.
#
# Only two kinds of properties belong here:
#   1. Things that actually change how code is formatted in this repo.
#   2. ktlint rule toggles.
# Properties that merely restate a KOTLIN_OFFICIAL default are intentionally absent;
# `ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL` already supplies them.
#
# After changing anything here, run:  ./gradlew ktlintFormat
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[{*.kt,*.kts}]
indent_size = 4
max_line_length = 120
ij_continuation_indent_size = 4
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# ktlint engine. Set explicitly rather than inferred from the Gradle plugin so the
# IDE and CI resolve the same style. Do not also set `android = true` in Gradle —
# that would silently switch this to the android_studio style (100 columns).
ktlint_code_style = ktlint_official

# --- Imports -----------------------------------------------------------------
# Never collapse to star imports.
ij_kotlin_imports_layout = *
ij_kotlin_name_count_to_use_star_import = 9999
ij_kotlin_name_count_to_use_star_import_for_members = 9999
ij_java_names_count_to_use_import_on_demand = 9999
ij_kotlin_import_nested_classes = false

# --- Trailing commas ---------------------------------------------------------
# This repo uses trailing commas everywhere; they keep diffs to one line per change.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# --- Wrapping ----------------------------------------------------------------
# These are what give the codebase its current shape (one parameter per line,
# leading-dot call chains, expression bodies on their own line). Changing them
# will reformat large parts of the repo.
ij_kotlin_method_parameters_wrap = on_every_item
ij_kotlin_method_parameters_new_line_after_left_paren = true
ij_kotlin_method_parameters_right_paren_on_new_line = true
ij_kotlin_call_parameters_wrap = on_every_item
ij_kotlin_call_parameters_new_line_after_left_paren = true
ij_kotlin_call_parameters_right_paren_on_new_line = false
ij_kotlin_method_call_chain_wrap = normal
ij_kotlin_continuation_indent_for_chained_calls = true
ij_kotlin_continuation_indent_for_expression_bodies = true
ij_kotlin_continuation_indent_in_argument_lists = true
ij_kotlin_assignment_wrap = normal
ij_kotlin_wrap_expression_body_functions = 1
ij_kotlin_wrap_elvis_expressions = 1
ij_kotlin_extends_list_wrap = normal
ij_kotlin_class_annotation_wrap = split_into_lines
ij_kotlin_method_annotation_wrap = split_into_lines
ij_kotlin_field_annotation_wrap = off
ij_kotlin_parameter_annotation_wrap = off
ij_kotlin_variable_annotation_wrap = off
ij_kotlin_enum_constants_wrap = off
ij_kotlin_align_multiline_parameters = true
ij_kotlin_blank_lines_after_class_header = 0

# --- ktlint rules ------------------------------------------------------------
# Composables are PascalCase by convention; @Preview functions follow suit.
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview
# Unused imports are an error, not a warning.
ktlint_standard_no-unused-imports = enabled

# -----------------------------------------------------------------------------
# Test sources.
#
# ktlint stays ENABLED here on purpose. The unit-test suite is the part of this
# codebase that is meant to grow the most (target: 90-100% coverage), so it is
# exactly the code that should not be exempt from formatting rules.
# Only the naming rules are relaxed, for backticked descriptive test names.
# -----------------------------------------------------------------------------
[**/src/{test,androidTest}/**/*.kt]
ktlint_standard_function-naming = disabled
ktlint_standard_class-naming = disabled
# Stops backticked test names from being measured and flagged as identifiers.
ktlint_ignore_back_ticked_identifier = true
# Fakes and fixtures often need long literal payloads.
max_line_length = 140

# -----------------------------------------------------------------------------
# Generated output. Never format-gated. The Gradle ktlint filter in
# build.gradle.kts already excludes these paths; this is here so the IDE agrees.
#
# NOTE: editorconfig does not allow comments on a section header line — they must
# be on their own line, as here. The previous version of this file had them
# inline, which folded the comment text into the glob.
#
# `ktlint = disabled` (used by the previous version) is NOT a ktlint 1.x property
# and was silently ignored. Disabling a whole ruleset is spelled `ktlint_standard`.
# -----------------------------------------------------------------------------
[**/build/**]
ktlint_standard = disabled
ktlint_experimental = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.xml]
indent_size = 4
ij_xml_space_inside_empty_tag = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.pro]
indent_size = 4

[{gradle.properties,*.toml}]
indent_size = 4
