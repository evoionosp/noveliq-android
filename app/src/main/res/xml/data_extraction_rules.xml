<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Auth tokens and custom headers (which may carry API keys) must never leave the device. -->
        <exclude domain="sharedpref" path="session_store.xml"/>
        <exclude domain="sharedpref" path="connection_store.xml"/>
    </cloud-backup>
</data-extraction-rules>
